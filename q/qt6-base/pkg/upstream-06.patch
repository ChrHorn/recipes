From 8d685db21013831ccd5e6c0631df0d6dba33faaf Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?M=C3=A9ven=20Car?= <meven@kde.org>
Date: Wed, 7 Oct 2026 10:58:59 +0000
Subject: [PATCH] QIcon: keep the aspect ratio of a file decoded at a scaled
 size

QPixmapIconEngine reads a file with QImageReader::setScaledSize()
when the format supports it. That option was meant for scalable
formats like SVG, but the JPEG reader supports it too. The scaled
size is exact, so a non-square JPEG was decoded to the square size
of the request, and the icon showed it squeezed.

Fit the requested size to the aspect ratio of the image before
setting it as the scaled size.

Amends 9eddf930a274757c91290d56d10177f4ff94c4bb.

Pick-to: 6.11 6.10
Change-Id: I16cc2d9e1c5bf278463ac74b13df75dc3a8d5ff6
Reviewed-by: Christian Ehrlicher <ch.ehrlicher@gmx.de>
(cherry picked from commit f7dfd343eaec5ab586fcf7a26d8c5d98bd9d1693)
Reviewed-by: Qt Cherry-pick Bot <cherrypick_bot@qt-project.org>
Origin: upstream, https://invent.kde.org/qt/qt/qtbase/-/commit/8d685db21013831ccd5e6c0631df0d6dba33faaf
Forwarded: not-needed
Last-Update: 2026-10-29
---
 src/gui/image/qicon.cpp                  |  9 +++++++--
 tests/auto/gui/image/qicon/tst_qicon.cpp | 19 +++++++++++++++++++
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/src/gui/image/qicon.cpp b/src/gui/image/qicon.cpp
index df26706d880..7966ee1a1fa 100644
--- a/src/gui/image/qicon.cpp
+++ b/src/gui/image/qicon.cpp
@@ -42,8 +42,13 @@ public:
         : m_reader(fileName)
         , m_atEnd(false)
     {
-        if (m_reader.supportsOption(QImageIOHandler::ScaledSize))
-            m_reader.setScaledSize(size);
+        if (m_reader.supportsOption(QImageIOHandler::ScaledSize)) {
+            // The scaled size is exact, so fit it to the aspect ratio of the image.
+            const QSize imageSize = m_reader.size();
+            m_reader.setScaledSize(!imageSize.isEmpty() && !size.isEmpty()
+                                           ? imageSize.scaled(size, Qt::KeepAspectRatio)
+                                           : size);
+        }
     }
 
     QByteArray format() const { return m_reader.format(); }
diff --git a/tests/auto/gui/image/qicon/tst_qicon.cpp b/tests/auto/gui/image/qicon/tst_qicon.cpp
index 695596b181d..371f480208f 100644
--- a/tests/auto/gui/image/qicon/tst_qicon.cpp
+++ b/tests/auto/gui/image/qicon/tst_qicon.cpp
@@ -6,6 +6,7 @@
 #include <QBuffer>
 #include <QStandardPaths>
 #include <QPainter>
+#include <QTemporaryFile>
 #if QT_CONFIG(process)
 #include <QProcess>
 #endif
@@ -33,6 +34,7 @@ private slots:
     void cacheKey();
     void detach();
     void addFile();
+    void addFileKeepsAspectRatio();
     void pixmap();
     void pixmapByDprFromEngine_data();
     void pixmapByDprFromEngine();
@@ -436,6 +438,23 @@ void tst_QIcon::addFile()
         expectedHighDpiImage(128, ":/styles/commonstyle/images/standardbutton-save-%1.png"));
 }
 
+void tst_QIcon::addFileKeepsAspectRatio()
+{
+    // A JPEG is decoded at the requested size, which must not squeeze it into a square.
+    if (!QImageReader::supportedImageFormats().contains("jpeg"))
+        QSKIP("This test requires the JPEG image format plugin");
+
+    QTemporaryFile file;
+    QVERIFY(file.open());
+    QImage image(40, 80, QImage::Format_RGB32);
+    image.fill(Qt::red);
+    QVERIFY(image.save(&file, "JPEG"));
+    file.close();
+
+    const QIcon icon(file.fileName());
+    QCOMPARE(icon.pixmap(QSize(32, 32), 1.0).size(), QSize(16, 32));
+}
+
 void tst_QIcon::pixmap()
 {
     QIcon icon;
