From 26ea8162ff0089052384bf5339c08a3808020bc2 Mon Sep 17 00:00:00 2001
From: Tian Shilin <tianshilin@uniontech.com>
Date: Mon, 19 Oct 2026 17:02:07 +0800
Subject: [PATCH] QXdgDesktopPortalFileDialog: Reset per-open dialog flags

initializeDialog() only ever set saveFile, multipleFiles and
directoryMode to true. Reusing the same helper for a later open kept
the old state, so an AcceptOpen request after an AcceptSave request was
still sent to the portal as SaveFile.

Assign all three flags from the current options on every open.

Fixes: QTBUG-150535
Pick-to: 6.8
Change-Id: I33a94c618cedb21f08bc0d82b18cd4b810177a32
Reviewed-by: Oliver Eftevaag <oliver.eftevaag@qt.io>
Reviewed-by: Jan Grulich <jgrulich@redhat.com>
(cherry picked from commit 712c397090f36f8114b14eba24f1768301851c06)
Reviewed-by: Qt Cherry-pick Bot <cherrypick_bot@qt-project.org>
Origin: upstream, https://invent.kde.org/qt/qt/qtbase/-/commit/26ea8162ff0089052384bf5339c08a3808020bc2
Forwarded: not-needed
Last-Update: 2026-10-29
---
 .../xdgdesktopportal/qxdgdesktopportalfiledialog.cpp   | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/src/plugins/platformthemes/xdgdesktopportal/qxdgdesktopportalfiledialog.cpp b/src/plugins/platformthemes/xdgdesktopportal/qxdgdesktopportalfiledialog.cpp
index 2fe8dafa98d..fe6d891c820 100644
--- a/src/plugins/platformthemes/xdgdesktopportal/qxdgdesktopportalfiledialog.cpp
+++ b/src/plugins/platformthemes/xdgdesktopportal/qxdgdesktopportalfiledialog.cpp
@@ -124,11 +124,10 @@ void QXdgDesktopPortalFileDialog::initializeDialog()
     if (d->nativeFileDialog)
         d->nativeFileDialog->setOptions(options());
 
-    if (options()->fileMode() == QFileDialogOptions::ExistingFiles)
-        d->multipleFiles = true;
+    d->multipleFiles = options()->fileMode() == QFileDialogOptions::ExistingFiles;
 
-    if (options()->fileMode() == QFileDialogOptions::Directory || options()->fileMode() == QFileDialogOptions::DirectoryOnly)
-        d->directoryMode = true;
+    d->directoryMode = options()->fileMode() == QFileDialogOptions::Directory
+            || options()->fileMode() == QFileDialogOptions::DirectoryOnly;
 
     if (options()->isLabelExplicitlySet(QFileDialogOptions::Accept))
         d->acceptLabel = options()->labelText(QFileDialogOptions::Accept);
@@ -136,8 +135,7 @@ void QXdgDesktopPortalFileDialog::initializeDialog()
     if (!options()->windowTitle().isEmpty())
         d->title = options()->windowTitle();
 
-    if (options()->acceptMode() == QFileDialogOptions::AcceptSave)
-        d->saveFile = true;
+    d->saveFile = options()->acceptMode() == QFileDialogOptions::AcceptSave;
 
     if (!options()->nameFilters().isEmpty())
         d->nameFilters = options()->nameFilters();
