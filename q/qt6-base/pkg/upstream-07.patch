diff --git a/src/corelib/mimetypes/qmimemagicrule.cpp b/src/corelib/mimetypes/qmimemagicrule.cpp
index aba11f54450..91a5f58eb85 100644
--- a/src/corelib/mimetypes/qmimemagicrule.cpp
+++ b/src/corelib/mimetypes/qmimemagicrule.cpp
@@ -157,14 +157,14 @@ static inline QByteArray makePattern(const QByteArray &value)
     const char *e = p + value.size();
     for ( ; p < e; ++p) {
         if (*p == '\\' && ++p < e) {
-            if (*p == 'x') { // hex (\\xff)
-                char c = 0;
+            if (*p == 'x') { // hex (\\xff), up to 2 digits; a literal 'x' if none
+                char c = 'x';
                 for (int i = 0; i < 2 && p + 1 < e; ++i) {
+                    const int h = fromHex(p[1]);
+                    if (h == -1)
+                        break;
                     ++p;
-                    if (const int h = fromHex(*p); h != -1)
-                        c = (c << 4) + h;
-                    else
-                        continue;
+                    c = i == 0 ? char(h) : char((c << 4) + h);
                 }
                 *data++ = c;
             } else if (isOctalDigit(*p)) { // oct (\\7, or \\77, or \\377)
diff --git a/tests/auto/corelib/mimetypes/qmimedatabase/hex-escape-magic.xml b/tests/auto/corelib/mimetypes/qmimedatabase/hex-escape-magic.xml
new file mode 100644
index 00000000000..ba60b4bc573
--- /dev/null
+++ b/tests/auto/corelib/mimetypes/qmimedatabase/hex-escape-magic.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<mime-info xmlns='http://www.freedesktop.org/standards/shared-mime-info'>
+    <mime-type type="application/x-hex-escape">
+        <comment>Magic value with single-digit hex escapes</comment>
+        <magic>
+            <match type="string" value="\xa\x0\x0\x0HEX" offset="0"/>
+            <!-- \x without hex digit is a literal x, like in update-mime-database -->
+            <match type="string" value="\xZ\x4A\x4a\x4\nHEX2" offset="0"/>
+        </magic>
+    </mime-type>
+</mime-info>
